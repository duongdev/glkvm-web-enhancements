{
  "manifest_version": 3,
  "name": "GLKVM Web Enhancements",
  "version": "1.0.0",
  "description": "Speaker/mic device pickers, Picture-in-Picture, live data totals, fullscreen keyboard capture and a tidier toolbar for the GLKVM web UI.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GLKVM Web Enhancements",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-mono-16.png",
      "32": "icons/icon-mono-32.png",
      "48": "icons/icon-mono-48.png",
      "128": "icons/icon-mono-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://glkvm.local/*",
        "https://*.ts.net/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://glkvm.local/*",
        "https://*.ts.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
